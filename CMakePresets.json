{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64 Debug (Visual Studio, no Developer shell needed)",
      "description": "Run from any PowerShell. CMake uses the Visual Studio installation directly.",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release (Visual Studio, no Developer shell needed)",
      "description": "Run from any PowerShell. CMake uses the Visual Studio installation directly.",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "mingw-debug",
      "displayName": "MinGW GCC Debug (Windows)",
      "description": "Requires gcc/g++ on PATH, e.g. from an MSYS2 UCRT64 shell.",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW GCC Release (Windows)",
      "description": "Requires gcc/g++ on PATH, e.g. from an MSYS2 UCRT64 shell.",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (system GCC/Clang)",
      "description": "Needs the X11 and OpenGL development packages.",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release (system GCC/Clang)",
      "description": "Needs the X11 and OpenGL development packages.",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug (AppleClang)",
      "description": "Uses Xcode's clang; nothing to install.",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release (AppleClang)",
      "description": "Uses Xcode's clang; nothing to install.",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],

  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug", "configuration": "Debug" },
    { "name": "windows-release", "configurePreset": "windows-release", "configuration": "Release" },
    { "name": "mingw-debug", "configurePreset": "mingw-debug" },
    { "name": "mingw-release", "configurePreset": "mingw-release" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "macos-debug", "configurePreset": "macos-debug" },
    { "name": "macos-release", "configurePreset": "macos-release" }
  ],

  "workflowPresets": [
    { "name": "windows-debug", "steps": [ { "type": "configure", "name": "windows-debug" }, { "type": "build", "name": "windows-debug" } ] },
    { "name": "windows-release", "steps": [ { "type": "configure", "name": "windows-release" }, { "type": "build", "name": "windows-release" } ] },
    { "name": "mingw-debug", "steps": [ { "type": "configure", "name": "mingw-debug" }, { "type": "build", "name": "mingw-debug" } ] },
    { "name": "mingw-release", "steps": [ { "type": "configure", "name": "mingw-release" }, { "type": "build", "name": "mingw-release" } ] },
    { "name": "linux-debug", "steps": [ { "type": "configure", "name": "linux-debug" }, { "type": "build", "name": "linux-debug" } ] },
    { "name": "linux-release", "steps": [ { "type": "configure", "name": "linux-release" }, { "type": "build", "name": "linux-release" } ] },
    { "name": "macos-debug", "steps": [ { "type": "configure", "name": "macos-debug" }, { "type": "build", "name": "macos-debug" } ] },
    { "name": "macos-release", "steps": [ { "type": "configure", "name": "macos-release" }, { "type": "build", "name": "macos-release" } ] }
  ]
}